if (!isLastMessage) return;

const shouldScroll =
lastMessage.senderId === currentUserId ||
isNearBottom() ||
pendingMediaScrollMessageIdRef.current === messageId;

if (!shouldScroll) return;

requestAnimationFrame(() => {
