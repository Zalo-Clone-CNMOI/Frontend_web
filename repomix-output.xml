        <MenuButton
          size="small"
          onClick={(e) => {
            e.stopPropagation();
            onMenuClick(message, e);
          }}
        >
          <MoreVertIcon sx={{ fontSize: 18 }} />
        </MenuButton>
      </RightSection>
    </Container>
  );
}
