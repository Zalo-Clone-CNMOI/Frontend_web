  };
  members: ConversationDto["members"];
  isCurrentUser?: boolean;
  isSpeaking?: boolean;
  showAudioVisualizer?: boolean;
  size?: "small" | "medium" | "large";
}

const ParticipantCard = memo(function ParticipantCard({ 
