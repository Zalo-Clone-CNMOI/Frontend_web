  return {
    imageAttachments: safeAttachments.filter((file) => file.type === "image"),
    videoAttachments: safeAttachments.filter((file) => file.type === "video"),
    otherAttachments: safeAttachments.filter(
      (file) => file.type !== "image" && file.type !== "video"
    ),
  };
};

